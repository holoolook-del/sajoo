# 이미지 생성 스크립트 전용 (개발 중 1회 사용, 앱 번들에 포함되지 않음)
# Replicate flux-schnell — https://replicate.com 에서 발급
REPLICATE_API_TOKEN=
# Gemini 무료 키는 이미지 생성 쿼터가 0이라 사용 불가 — 참고용으로만 남김
GEMINI_API_KEY=

# ── 게시판·동시접속자 (Firebase) — 로컬 dev는 .env에, 배포 빌드는 GitHub repo Variables에 ──
# Firebase 콘솔 → 프로젝트 설정 → 일반 → 내 앱(웹)의 config 값
# 배포: github.com/<repo> → Settings → Secrets and variables → Actions → Variables 탭에
#        같은 5개 이름으로 등록하면 deploy.yml이 빌드에 주입한다.
# ※ 이 값들은 비밀이 아니다 — 클라이언트 번들에 포함되는 게 정상이고,
#    보안은 firestore.rules / database.rules.json이 담당한다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_APP_ID=
