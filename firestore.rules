rules_version = '2';

// Firebase 콘솔 → Firestore Database → 규칙 탭에 붙여넣기
// 게시판: 읽기는 모두, 쓰기는 익명 인증 uid 소유만. 필드·길이 검증으로 악용 방지.
service cloud.firestore {
  // 욕설·혐오·광고 유도·링크 서버 차단 — 클라이언트 checkText(src/features/board/filter.ts)와 같은 목적.
  // RE2는 백레퍼런스 미지원이라 도배 반복 검사는 클라이언트만 담당.
  function cleanText(s) {
    return !s.matches('.*(시발|씨발|ㅅㅂ|ㅆㅂ|개새끼|개새|지랄|병신|ㅂㅅ|좆|보지|자지|섹스|sex|fuck|미친놈|미친년|니애미|느금마|창녀|걸레).*')
      && !s.matches('.*https?://.*')
      && !s.matches('.*(텔레그램|카톡방|오픈채팅).*')
      && !s.matches('.*(대출|투자|코인|수익률|부업|재테크).*(문의|상담|링크|연락).*');
  }
  match /databases/{db}/documents {
    // 관리자 — 콘솔에서만 admins/{uid} 문서를 만든다. 클라이언트는 자기 문서만 읽어 관리자 여부 확인.
    function isAdmin() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /admins/{adminUid} {
      allow get: if request.auth != null && request.auth.uid == adminUid;
      allow list, write: if false;
    }
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'nick', 'text', 'card', 'ts', 'likes', 'reports', 'comments'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nick is string
        && request.resource.data.nick.size() <= 12
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 300
        && cleanText(request.resource.data.nick)
        && cleanText(request.resource.data.text)
        && request.resource.data.get('likes', 0) == 0
        && request.resource.data.get('reports', 0) == 0
        && request.resource.data.get('comments', 0) == 0
        && request.resource.data.ts == request.time;
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      // 좋아요·신고·댓글수 카운터만 +1 증분 허용 — 다른 필드 수정 불가. 관리자는 댓글 삭제 시 comments -1 감분 허용.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'reports', 'comments'])
        && request.resource.data.get('likes', 0) >= resource.data.get('likes', 0)
        && request.resource.data.get('reports', 0) >= resource.data.get('reports', 0)
        && request.resource.data.get('comments', 0) >= 0
        && request.resource.data.get('likes', 0) <= resource.data.get('likes', 0) + 1
        && request.resource.data.get('reports', 0) <= resource.data.get('reports', 0) + 1
        && request.resource.data.get('comments', 0) <= resource.data.get('comments', 0) + 1
        && (request.resource.data.get('comments', 0) >= resource.data.get('comments', 0)
          || (isAdmin() && request.resource.data.get('comments', 0) >= resource.data.get('comments', 0) - 1));

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['uid', 'nick', 'text', 'ts'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.nick is string
          && request.resource.data.nick.size() <= 12
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 150
          && cleanText(request.resource.data.nick)
          && cleanText(request.resource.data.text)
          && request.resource.data.ts == request.time;
        allow update: if false;
        allow delete: if request.auth != null && isAdmin();
      }
    }
  }
}
