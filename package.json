{
  "name": "sajoo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "e2e": "playwright test",
    "e2e:preview": "pnpm build && playwright test -c playwright.preview.config.ts",
    "audit:code": "knip && jscpd src e2e",
    "gen:images": "tsx scripts/gen-images.ts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "manseryeok": "2.0.0",
    "motion": "13.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "jscpd": "5.4.0",
    "jsdom": "30.1.1",
    "knip": "6.39.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@10.33.2"
}
